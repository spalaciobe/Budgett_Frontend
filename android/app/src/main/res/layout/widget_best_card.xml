<?xml version="1.0" encoding="utf-8"?>
<!-- "Best card today" home-screen widget. Texts are placeholders for the
     widget picker preview; BestCardWidgetProvider replaces all of them. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.08"
        android:text="BEST CARD TODAY"
        android:textColor="@color/widget_muted"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/card_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:text="Your credit card"
        android:textColor="@color/widget_on_surface"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/days"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="sans-serif-medium"
        android:text="45 days to pay"
        android:textColor="@color/widget_accent"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/due"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Due Mon, Jan 5"
        android:textColor="@color/widget_muted"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/others"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Next: Another card 30d"
        android:textColor="@color/widget_muted"
        android:textSize="12sp" />
</LinearLayout>
