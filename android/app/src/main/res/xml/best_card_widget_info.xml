<?xml version="1.0" encoding="utf-8"?>
<!-- updatePeriodMillis is only the fallback; an alarm after midnight does the
     daily flip. The layout itself is the preview on Android 12+. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/best_card_widget_description"
    android:initialLayout="@layout/widget_best_card"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:minResizeWidth="140dp"
    android:minResizeHeight="90dp"
    android:previewLayout="@layout/widget_best_card"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:updatePeriodMillis="3600000"
    android:widgetCategory="home_screen" />
